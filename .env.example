# AICIS local environment template
# Copy this file to .env.local for frontend development.
# Configure server-side values in Supabase function secrets, not in Vite.

VITE_SUPABASE_URL=replace-with-your-supabase-url
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-public-browser-key
# Enable only after the active Supabase project has Google OAuth configured
# and the deployment origin is present in the Auth redirect allowlist.
VITE_ENABLE_GOOGLE_OAUTH=false

SUPABASE_URL=configure-in-supabase-function-secrets
SUPABASE_ANON_KEY=configure-in-supabase-function-secrets
SUPABASE_SERVICE_ROLE_KEY=configure-in-supabase-function-secrets

CRON_SECRET=configure-in-supabase-function-secrets

# AICIS Sovereign AI Gateway v1
# No external provider or model is assumed. All routing is explicit.
# sovereign: local/private or explicitly allowlisted AICIS-controlled endpoint only
# hybrid: sovereign core with explicitly configured external model access allowed
# research: controlled benchmarking/comparison mode; not a production default
AICIS_AI_MODE=sovereign
AICIS_MODEL_ENDPOINT=https://your-sovereign-model-host.example/v1/chat/completions
AICIS_MODEL_NAME=replace-with-explicit-model-id
AICIS_MODEL_PROVIDER=self-hosted
# Required for any public sovereign endpoint; optional only for local/private endpoints.
AICIS_MODEL_API_KEY=configure-in-supabase-function-secrets
# Comma-separated exact hostnames or wildcard suffixes such as *.models.example.org.
# A public endpoint is rejected in sovereign mode unless it matches this allowlist.
AICIS_SOVEREIGN_MODEL_HOSTS=your-sovereign-model-host.example

ALPHA_VANTAGE_API_KEY=configure-in-supabase-function-secrets
EIA_API_KEY=configure-in-supabase-function-secrets
STRIPE_SECRET_KEY=configure-in-supabase-function-secrets
STRIPE_WEBHOOK_SECRET=configure-in-supabase-function-secrets
